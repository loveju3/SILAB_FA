# Build from the repository root. Fine-tuned weights are mounted at /model.
FROM python:3.13-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2 \
    MKL_NUM_THREADS=2 \
    TOKENIZERS_PARALLELISM=false \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1
COPY Solution/requirements-ml.txt Solution/requirements-embedding.txt /app/
RUN pip install --no-cache-dir torch==2.9.0 --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir -r /app/requirements-embedding.txt
COPY data/devices.json data/error_codes.json /app/data/
COPY predict.py /app/predict.py
COPY Solution/triage/ /app/Solution/triage/
COPY Solution/config/ /app/Solution/config/
COPY Solution/predict.py /app/Solution/predict.py
COPY Solution/scripts/check_limits.py /app/Solution/scripts/check_limits.py
ENTRYPOINT ["python3"]
CMD ["predict.py", "/input/tickets.jsonl", "/results/finetuned_predictions.jsonl", "--method", "bge-finetuned", "--model-path", "/model"]
